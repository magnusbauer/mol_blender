include LICENSE THIRD_PARTY_NOTICES.md AGENTS.md CLAUDE.md
include render_defaults.yaml
include uv.lock .python-version
recursive-include runtime *.in
recursive-include mol_blender *.html
recursive-include LICENSES *.txt
# Ship only the public documentation listed here, never draft/private notes.
include docs/README.md
include docs/install-co-pymol.md docs/install-claude.md docs/co-pymol/README.md
include docs/install-windows.md
include docs/windows-git-guide-zh.md
include docs/windows-validation.md
include docs/animation.md docs/reference-presets.md
include docs/blender-editing.md docs/chat-editing.md
include docs/local-worker.md docs/runtime-environments.md docs/shared-cluster.md
include docs/hosted-adapter.md
include docs/dependency-source-manifest.json
prune .validation
recursive-include examples *.cif *.json *.png *.pse *.py
recursive-include .agents/skills *.md
recursive-include .claude/skills *.md
recursive-include scripts *.py
include scripts/install-windows.ps1
global-exclude *.pyc
global-exclude __pycache__
