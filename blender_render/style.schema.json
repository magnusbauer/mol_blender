{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/pymol-blender-bridge/style.schema.json",
  "title": "PyMOL Blender Bridge Full Custom Style",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "output",
    "renderer",
    "camera",
    "world",
    "lights",
    "materials",
    "styles"
  ],
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version string, for example 1.0"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "width",
        "height",
        "samples"
      ],
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "PNG",
            "JPEG",
            "TIFF",
            "OPEN_EXR"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "samples": {
          "type": "integer",
          "minimum": 1
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "save_blend": {
          "type": "boolean"
        },
        "blend_filename": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "raw_view": {
          "type": "boolean"
        },
        "animation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "none",
                "rock",
                "360"
              ]
            },
            "duration": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 15
            },
            "fps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            },
            "rock_angle": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 45
            },
            "gif": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine"
      ],
      "properties": {
        "engine": {
          "type": "string",
          "enum": [
            "CYCLES",
            "BLENDER_EEVEE",
            "EEVEE"
          ]
        },
        "device": {
          "type": "string",
          "enum": [
            "GPU",
            "CPU"
          ]
        },
        "compute_device_type": {
          "type": "string"
        },
        "transparent_background": {
          "type": "boolean"
        },
        "adaptive_sampling": {
          "type": "boolean"
        },
        "require_gpu": {
          "type": "boolean"
        },
        "exposure": {
          "type": "number"
        },
        "gamma": {
          "type": "number",
          "minimum": 0.01
        },
        "view_transform": {
          "type": "string"
        },
        "look": {
          "type": "string"
        },
        "seed": {
          "type": "integer"
        },
        "denoise": {
          "type": "boolean"
        },
        "adaptive_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "pymol",
            "override"
          ]
        },
        "lens_mm": {
          "type": "number"
        },
        "shift_x": {
          "type": "number"
        },
        "shift_y": {
          "type": "number"
        },
        "world_scale": {
          "type": "number",
          "minimum": 0
        },
        "override_intrinsics": {
          "type": "boolean"
        },
        "direction_source": {
          "type": "string",
          "enum": [
            "preset",
            "pymol"
          ]
        },
        "yaw_offset_deg": {
          "type": "number"
        },
        "pitch_offset_deg": {
          "type": "number"
        },
        "yaw_deg": {
          "type": "number",
          "description": "Absolute yaw in degrees; requires mode=override and direction_source=preset. An angle override selects these defaults unless explicitly specified."
        },
        "pitch_deg": {
          "type": "number",
          "description": "Absolute pitch in degrees; requires mode=override and direction_source=preset. Use pitch_offset_deg for PyMOL-relative rotation."
        },
        "distance_scale": {
          "type": "number",
          "minimum": 0
        },
        "focus_style": {
          "type": "string"
        },
        "clip_start": {
          "type": "number",
          "minimum": 0
        },
        "clip_end": {
          "type": "number",
          "minimum": 0
        },
        "preserve_framing": {
          "type": "boolean"
        },
        "roll_deg": {
          "type": "number"
        },
        "fit": {
          "type": "boolean"
        },
        "fit_margin": {
          "type": "number",
          "minimum": 1
        },
        "ortho_scale_angstrom": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "depth_of_field": {
          "type": "object",
          "additionalProperties": false,
          "required": ["focus_distance_angstrom"],
          "description": "Omit to disable. Requires mode=override, projection=PERSP, and a ray-traced output. Focus is measured from the final camera along its optical axis; geometry and framing are unchanged.",
          "properties": {
            "focus_distance_angstrom": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 1000000,
              "description": "Optical-axis distance from the final camera in angstroms (0.01 Blender units per angstrom). Required; independent of camera.world_scale."
            },
            "f_stop": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 128,
              "default": 2.8,
              "description": "Dimensionless aperture f-number. Smaller values increase defocus."
            }
          }
        },
        "projection": {
          "enum": [
            "ORTHO",
            "PERSP"
          ]
        }
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background_type": {
          "type": "string",
          "enum": [
            "solid",
            "gradient"
          ]
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "top_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "bottom_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "strength": {
          "type": "number",
          "minimum": 0
        },
        "gradient_direction": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "ambient_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "ambient_strength": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "lights": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "energy"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "AREA",
              "SUN",
              "POINT",
              "SPOT"
            ]
          },
          "energy": {
            "type": "number"
          },
          "size": {
            "type": "number",
            "minimum": 0
          },
          "size_scale": {
            "type": "number",
            "minimum": 0
          },
          "min_size": {
            "type": "number",
            "minimum": 0
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "location": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "rotation_deg": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "relative_vector": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "distance_scale": {
            "type": "number",
            "minimum": 0
          },
          "look_at_target": {
            "type": "boolean"
          },
          "rotate_with_pymol_yaw": {
            "type": "boolean"
          },
          "camera_space": {
            "type": "boolean"
          },
          "normalize_energy": {
            "type": "boolean"
          }
        }
      }
    },
    "materials": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "base_color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "shadow_color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "highlight_color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "roughness": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "specular": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "transmission": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "alpha": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "emission_color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "emission_strength": {
            "type": "number",
            "minimum": 0
          },
          "ao_strength": {
            "type": "number",
            "minimum": 0
          },
          "rim_strength": {
            "type": "number",
            "minimum": 0
          },
          "rim_blend": {
            "type": "number",
            "minimum": 0
          },
          "rim_power": {
            "type": "number",
            "minimum": 0
          },
          "ao_distance": {
            "type": "number",
            "minimum": 0
          },
          "coat": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "glow": {
            "type": "object",
            "additionalProperties": false,
            "required": ["strength", "threshold", "size"],
            "properties": {
              "strength": {"type": "number", "minimum": 0},
              "threshold": {"type": "number", "minimum": 0},
              "size": {"type": "integer", "minimum": 2, "maximum": 9}
            }
          },
          "edge_highlight": {
            "type": "object",
            "additionalProperties": false,
            "required": ["power", "color", "strength"],
            "properties": {
              "power": {"type": "number", "exclusiveMinimum": 0},
              "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
              "strength": {"type": "number", "minimum": 0}
            }
          },
          "paint": {
            "$ref": "#/$defs/paint"
          },
          "color_attribute": {
            "type": "string",
            "enum": [
              "Color",
              "ElementColor"
            ]
          },
          "color_gradient": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "colors",
              "direction"
            ],
            "properties": {
              "colors": {
                "type": "array",
                "minItems": 2,
                "maxItems": 8,
                "items": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                }
              },
              "direction": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              }
            }
          },
          "frosted": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "noise_scale",
              "opacity_min",
              "opacity_max",
              "grid_scale",
              "grid_width",
              "grid_strength",
              "grid_color"
            ],
            "properties": {
              "coordinates": {
                "type": "string",
                "enum": ["generated", "angstrom"]
              },
              "noise_scale": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "opacity_min": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "opacity_max": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "grid_scale": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "grid_width": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.1
              },
              "grid_strength": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "grid_color": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              }
            }
          }
        }
      },
      "propertyNames": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "styles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "style",
          "selection",
          "material"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "style": {
            "type": "string",
            "enum": [
              "surface",
              "cartoon",
              "sticks",
              "spheres",
              "ribbon",
              "wire"
            ]
          },
          "ligand_cutout_roll_deg": {
            "type": "number"
          },
          "material": {
            "type": "string",
            "minLength": 1
          },
          "color": {
            "type": "string"
          },
          "selection": {
            "$ref": "#/$defs/selectionDsl"
          },
          "fallback_selection": {
            "$ref": "#/$defs/selectionDsl"
          },
          "radius": {
            "type": "number",
            "minimum": 0
          },
          "quality": {
            "type": "number",
            "minimum": 0
          },
          "probe_radius": {
            "type": "number",
            "minimum": 0
          },
          "subdivisions": {
            "type": "integer",
            "minimum": 0
          },
          "thickness": {
            "type": "number",
            "minimum": 0
          },
          "width": {
            "type": "number",
            "minimum": 0
          },
          "loop_radius": {
            "type": "number",
            "minimum": 0
          },
          "shade_smooth": {
            "type": "boolean"
          },
          "peptide_cylinders": {
            "type": "boolean"
          },
          "peptide_rounded": {
            "type": "boolean"
          },
          "peptide_smoothing": {
            "type": "number",
            "minimum": 0
          },
          "nucleic_thickness": {
            "type": "number",
            "minimum": 0
          },
          "nucleic_width": {
            "type": "number",
            "minimum": 0
          },
          "nucleic_radius": {
            "type": "number",
            "minimum": 0
          },
          "backbone_shape": {
            "type": "string"
          },
          "base_shape": {
            "type": "string"
          },
          "base_realize": {
            "type": "boolean"
          },
          "color_blur": {
            "type": "boolean"
          },
          "sticks_radius": {
            "type": "number",
            "minimum": 0
          },
          "sticks_quality": {
            "type": "number",
            "minimum": 0
          },
          "sticks_shade_smooth": {
            "type": "boolean"
          },
          "ligand_cutout_radius": {
            "type": "number",
            "minimum": 0
          },
          "ligand_cutout_offset": {
            "type": "number"
          },
          "ligand_cutout_auto_side": {
            "type": "boolean"
          },
          "ligand_cutout_axis_mode": {
            "type": "string",
            "enum": [
              "interface",
              "camera"
            ]
          },
          "ligand_cutout_flatten_z": {
            "type": "boolean"
          },
          "ligand_cutout_width_scale": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "ligand_cutout_depth_scale": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "ligand_cutout_height_scale": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "ligand_cutout_one_sided": {
            "type": "boolean"
          },
          "ligand_cutout_one_sided_shift_scale": {
            "type": "number",
            "minimum": 0
          },
          "ligand_cutout_cap_mode": {
            "type": "string",
            "enum": [
              "panel",
              "none"
            ]
          },
          "ligand_cutout_mode": {
            "type": "string",
            "enum": [
              "planes"
            ]
          },
          "ligand_cutout_frame_mode": {
            "type": "string",
            "enum": [
              "preset",
              "interface",
              "camera"
            ]
          },
          "ligand_cutout_frame_axes": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "y": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "z": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              }
            },
            "required": [
              "x",
              "y",
              "z"
            ]
          },
          "ligand_cutout_planes_enabled": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "left": {
                "type": "boolean"
              },
              "right": {
                "type": "boolean"
              },
              "top": {
                "type": "boolean"
              },
              "bottom": {
                "type": "boolean"
              },
              "back": {
                "type": "boolean"
              }
            }
          },
          "ligand_cutout_plane_scales": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "left": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "right": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "top": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "bottom": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "back": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "ligand_cutout_seal_mode": {
            "type": "string",
            "enum": [
              "boundary_fill",
              "trimmed_panel",
              "none"
            ]
          },
          "ligand_cutout_seal_depth_scale": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "ligand_cutout_seal_region_scale": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "ligand_cutout_selection": {
            "type": "boolean"
          },
          "ligand_cutout_mirror": {
            "type": "boolean"
          },
          "ligand_cutout_isolate": {
            "type": "boolean"
          },
          "del_solvent": {
            "type": "boolean"
          },
          "peptide_dssp": {
            "type": "boolean"
          },
          "peptide_arrows": {
            "type": "boolean"
          },
          "color_by_chain": {
            "type": "boolean"
          },
          "surface_scale_radius": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "wireframe_width_angstrom": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "wireframe_spacing_angstrom": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "surface_relaxation_steps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "nucleic_base_scale": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "color_follow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "type": "string",
          "enum": [
            "auto",
            "chain",
            "class"
          ]
        },
        "mix": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "saturation_boost": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "value_boost": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "edge_rounding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "radius_angstrom",
            "segments",
            "angle_degrees",
            "adaptive_clearance"
          ],
          "properties": {
            "radius_angstrom": {
              "type": "number",
              "minimum": 0,
              "maximum": 2
            },
            "segments": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "angle_degrees": {
              "type": "number",
              "minimum": 0,
              "maximum": 180
            },
            "adaptive_clearance": {
              "type": "boolean"
            }
          }
        },
        "secondary_structure_palette": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "helix",
            "sheet",
            "loop"
          ],
          "properties": {
            "helix": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              }
            },
            "sheet": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "loop": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            }
          }
        },
        "element_palette": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[A-Z]{1,2}$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          }
        }
      }
    }
  },
  "$defs": {
    "selectionDsl": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "polymer": {
          "type": "boolean"
        },
        "nucleic": {
          "type": "boolean"
        },
        "ligand": {
          "type": "boolean"
        },
        "chain": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
